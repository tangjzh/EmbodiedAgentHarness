# Copy to an ignored local .env or export explicitly. Never commit credentials.
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ECA_CLAUDE_BIN=/absolute/path/to/claude
ECA_MODEL=claude-opus-5-5
ECA_AGENT_IMAGE=eca-agent:2026-11
# Optional existing clones; defaults are external/<name>.
# ECA_RAX_ROOT=/path/to/rax-robodojo
# ECA_DEXJOCO_RAX_ROOT=/path/to/rax-dexjoco
# ECA_CAPX_ROOT=/path/to/cap-x
